@{
    ViewData["Title"] = "Red Social";
}

<h2>Bienvenido, @ViewBag.Nombre</h2>

<div id="contenedor-publicaciones">
    @if (ViewBag.Publicaciones != null)
    {
        @foreach (var publicacion in ViewBag.Publicaciones)
        {
            <article class="publicacion" style="border: 1px solid #ccc; margin-bottom: 15px; padding: 10px;">
                <h3>@publicacion.Titulo</h3>
                <p>@publicacion.Descripcion</p>

                @if (!string.IsNullOrEmpty(publicacion.Imagen))
                {
                    <img src="@publicacion.Imagen" alt="Imagen publicación" style="max-width: 300px;" />
                }

                <!-- Me gusta -->
                <div style="margin-top: 10px;">
                    <span id="me-gusta-@publicacion.Id">@(ViewBag.Likes != null && ViewBag.Likes.ContainsKey(publicacion.Id) ? ViewBag.Likes[publicacion.Id] : 0)</span> Me gusta
                    <button type="button" onclick="darMeGusta(@publicacion.Id)">Me gusta</button>
                </div>

                <!-- Comentarios -->
                <div style="margin-top: 10px;">
                    <ul id="comentarios-@publicacion.Id">
                        @if (ViewBag.Comentarios != null && ViewBag.Comentarios.ContainsKey(publicacion.Id))
                        {
                            @foreach (var com in ViewBag.Comentarios[publicacion.Id])
                            {
                                <li>@com.Texto</li>
                            }
                        }
                    </ul>
                    <input type="text" id="comentario-@publicacion.Id" placeholder="Escribe un comentario..." />
                    <button type="button" onclick="comentar(@publicacion.Id)">Comentar</button>
                </div>
            </article>
        }
    }
</div>

<div style="text-align: center; margin: 20px;">
    <button id="btn-ver-mas" onclick="cargarMasPublicaciones()">Ver más</button>
</div>

<script src="~/js/site.js"></script>